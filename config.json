{
  "http": { "host": "127.0.0.1", "port": 3000 },
  "mode": "mock",
  "tcp": {
    "role": "server", "host": "127.0.0.1", "port": 4010,
    "connectTimeoutMs": 3000, "idleTimeoutMs": null, "reconnectDelayMs": 1000, "maxReconnectDelayMs": 10000,
    "adapter": "simulator-line-v1",
    "framing": { "delimiter": "\n", "maxReceiveBufferBytes": 65536 },
    "encoding": "utf8", "serverConnectionPolicy": "single-reject",
    "captureRaw": { "enabled": true, "format": "hex", "maxCaptureBytes": 4096 }
  },
  "webhook": { "enabled": false, "url": null, "timeoutMs": 2000, "retry": 2, "retryDelayMs": 250, "maxQueueSize": 100 },
  "storage": { "maxResults": 500 },
  "log": { "path": "logs/gateway.log", "maxBytes": 1048576 },
  "shutdown": { "webhookDrainTimeoutMs": 5000 }
}
